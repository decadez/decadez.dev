{
  "name": "@decadez/web-dev-ui",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx/index.d.ts",
      "import": "./dist/mdx/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./animations": {
      "types": "./dist/animations/index.d.ts",
      "import": "./dist/animations/index.js"
    },
    "./animations/hooks": {
      "types": "./dist/animations/hooks/index.d.ts",
      "import": "./dist/animations/hooks/index.js"
    },
    "./animations/theme": {
      "types": "./dist/animations/theme/index.d.ts",
      "import": "./dist/animations/theme/index.js"
    },
    "./animations/*": {
      "types": "./dist/animations/components/*/index.d.ts",
      "import": "./dist/animations/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "src/assets",
    "src/styles.css",
    "README.md",
    "licenses"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/finalize-animations.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm lint && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/decadez/decadez.dev.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@lezer/highlight": "^1.2.3",
    "classnames": "^2.5.1",
    "parse-numeric-range": "^1.3.0"
  }
}
